# ============================================================
# TTS Caching Server — Environment Configuration
# ============================================================
# Copy this file to .env and adjust values as needed.
# All settings have sensible defaults for local development.
# ============================================================

# --- Cache storage ---
CACHE_DIR=./tts_cache

# --- Redis (via Docker: docker run -d --name tts-redis -p 6379:6379 redis:7-alpine) ---
REDIS_URL=redis://localhost:6379/0

# --- Cache limits ---
MAX_CACHE_SIZE_GB=10.0

# --- Eviction (optional, disabled by default) ---
EVICTION_ENABLED=false
EVICTION_THRESHOLD=0.8

# --- Demo mode (enables /demo/synthesize endpoint for testing) ---
DEMO_MODE_ENABLED=true

# --- Pre-generated audio fallback (serve from local files, skip external API) ---
PRE_GENERATED_DIR=./TTSPrompt

# --- External TTS API ---
# When demo_mode_enabled=true, this defaults to the built-in demo endpoint.
# Point to your real TTS API when ready.
TTS_API_BASE_URL=http://localhost:8000/demo
TTS_API_KEY=demo-key
TTS_API_TIMEOUT=30.0
TTS_API_MAX_RETRIES=3

# --- Distributed lock ---
LOCK_TIMEOUT_SECONDS=30
LOCK_RETRY_INTERVAL=0.5
LOCK_MAX_RETRIES=20

# --- Logging ---
LOG_LEVEL=INFO

# --- Azure TTS Settings ---
AZURE_SPEECH_KEY=your-azure-speech-key
AZURE_SPEECH_REGION=centralindia
